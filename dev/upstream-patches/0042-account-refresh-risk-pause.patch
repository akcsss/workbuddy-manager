@@ -0,0 +1,32 @@
+package scheduler
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+	"workbuddy2api/internal/auth"
+	"workbuddy2api/internal/pool"
+	"workbuddy2api/internal/upstream"
+)
+
+func TestRiskPausedAccountIsSkippedByNativeBackgroundTasks(t *testing.T) {
+	calls := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		w.WriteHeader(500)
+	}))
+	defer server.Close()
+	p := pool.New("")
+	defer p.Close()
+	p.Add(&auth.Auth{UID:"paused", AccessToken:"at", RefreshToken:"rt", ExpiresAt:time.Now().Add(24*time.Hour).Unix()})
+	p.PauseRefreshRateLimited("paused", 0)
+	up := upstream.New()
+	up.ChatBaseCN, up.BillingBaseCN = server.URL, server.URL
+	s := New(Config{Pool:p, Upstream:up})
+	s.RunCheckinNow()
+	s.RunKeepaliveNow()
+	s.RunActivityNow()
+	s.RunTravelNow()
+	if calls != 0 { t.Fatalf("paused account made %d background requests", calls) }
+}

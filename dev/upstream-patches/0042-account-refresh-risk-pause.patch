@@ -0,0 +1,46 @@
+package pool
+
+import (
+	"testing"
+	"time"
+	"workbuddy2api/internal/auth"
+)
+
+func TestRiskPauseIsAccountScopedAndRequiresExplicitEnable(t *testing.T) {
+	p := New("")
+	defer p.Close()
+	p.Add(&auth.Auth{UID: "bad"})
+	p.Add(&auth.Auth{UID: "good"})
+	if !p.PauseRefreshRateLimited("bad", time.Minute) || !p.RiskPaused("bad") {
+		t.Fatal("missing pause")
+	}
+	if p.RiskPaused("good") {
+		t.Fatal("unrelated account paused")
+	}
+	p.ReenableIfCredits("bad", 100)
+	p.ReviveDisabled("bad")
+	if !p.RiskPaused("bad") {
+		t.Fatal("automatic recovery cleared risk pause")
+	}
+	if p.PauseRefreshRateLimited("bad", time.Minute) {
+		t.Fatal("duplicate pause changed state")
+	}
+	p.SetManualDisabled("bad", false, "")
+	if p.RiskPaused("bad") {
+		t.Fatal("explicit enable did not clear pause")
+	}
+}
+
+func TestRiskPausePreservesOperatorIntent(t *testing.T) {
+	p := New("")
+	defer p.Close()
+	p.Add(&auth.Auth{UID: "u"})
+	p.SetManualDisabled("u", true, "operator pause")
+	if p.PauseRefreshRateLimited("u", 0) {
+		t.Fatal("overwrote operator pause")
+	}
+	_, reason, _ := p.ManualDisabledState("u")
+	if reason != "operator pause" {
+		t.Fatal(reason)
+	}
+}

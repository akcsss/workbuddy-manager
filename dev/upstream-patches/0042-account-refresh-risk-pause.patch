@@ -0,0 +1,31 @@
+package pool
+
+import (
+	"fmt"
+	"strings"
+	"time"
+)
+
+// RiskPausePrefix marks an operational safety pause, never an upstream ban.
+const RiskPausePrefix = "account-risk: "
+
+func (p *Pool) RiskPaused(uid string) bool {
+	p.mu.RLock()
+	defer p.mu.RUnlock()
+	e := p.byUID[uid]
+	return e != nil && e.manualDisabled && strings.HasPrefix(e.manualReason, RiskPausePrefix)
+}
+
+// PauseRefreshRateLimited does not overwrite an operator's existing pause or a
+// system ban. The existing persisted manual flag also blocks fallback selection.
+func (p *Pool) PauseRefreshRateLimited(uid string, retryAfter time.Duration) bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	e := p.byUID[uid]
+	if e == nil || e.disabled || e.manualDisabled {
+		return false
+	}
+	reason := fmt.Sprintf("%stoken_refresh HTTP 429 at=%s retry_after_sec=%d; manual review required", RiskPausePrefix, time.Now().UTC().Format(time.RFC3339), int64(retryAfter.Seconds()))
+	p.setManualDisabledLocked(e, true, reason)
+	return true
+}

+++ b/internal/upstream/refresh_risk_test.go
@@ -0,0 +1,38 @@
+package upstream
+
+import (
+	"net/http"
+	"testing"
+	"time"
+	"workbuddy2api/internal/auth"
+)
+
+func TestRefresh429PausesAndPreventsFurtherNetworkRequests(t *testing.T) {
+	calls, paused := 0, false
+	c := testClient(func(r *http.Request) (*http.Response, error) {
+		calls++
+		return jsonResp(429, `{"error_msg":"Too Many Requests"}`), nil
+	})
+	c.RefreshPaused = func(uid string) bool { return paused && uid == "u" }
+	c.OnRefreshRateLimit = func(uid string, _ time.Duration) {
+		if uid != "u" {
+			t.Fatal(uid)
+		}
+		paused = true
+	}
+	a := &auth.Auth{UID: "u", AccessToken: "at", RefreshToken: "rt"}
+	if c.RefreshToken(a) == nil || !paused {
+		t.Fatal("429 did not pause")
+	}
+	if c.RefreshToken(a) == nil || calls != 1 {
+		t.Fatalf("paused account sent %d requests", calls)
+	}
+}
+
+func TestRefresh500DoesNotPauseAccount(t *testing.T) {
+	c := testClient(func(r *http.Request) (*http.Response, error) { return jsonResp(500, `{"code":500}`), nil })
+	c.OnRefreshRateLimit = func(string, time.Duration) { t.Fatal("server error was treated as account restriction") }
+	if c.RefreshToken(&auth.Auth{UID: "u", RefreshToken: "rt"}) == nil {
+		t.Fatal("expected error")
+	}
+}
